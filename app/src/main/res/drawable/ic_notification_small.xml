<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon for the playback notification. It must stay a plain
     white silhouette: colours or an adaptive icon make the system reject the
     foreground-service notification and kill the app. The artwork is drawn inside a
     2.5..21.5 box centred on (12,12) so it sits straight in the square icon slot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- beam -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.5,4.5L21.5,2.5L21.5,7L7.5,9Z" />
    <!-- left stem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.5,4.5H9.5V18H7.5Z" />
    <!-- right stem -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19.5,2.5H21.5V16H19.5Z" />
    <!-- left note head -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M6,14.5a3.5,3.5 0 1,0 0,7a3.5,3.5 0 1,0 0,-7z" />
    <!-- right note head -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M18,12.5a3.5,3.5 0 1,0 0,7a3.5,3.5 0 1,0 0,-7z" />
</vector>
